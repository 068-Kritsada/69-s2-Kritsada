# REST

## Variables
@admin_email = {{$dotenv ADMIN_EMAIL}}
@admin_password = {{$dotenv ADMIN_PASSWORD}}
@user_email = {{$dotenv USER_EMAIL}}
@user_password = {{$dotenv USER_PASSWORD}}

## 1.Admin
### 1.1 Login
POST http://localhost:9092/admin/login
Content-Type: application/json

{
    "email": "{{admin_email}}",
    "password": "{{admin_password}}",
    "rememberMe": false
}

### 1.2 Register (admin) one time for first time to create admin account
POST http://localhost:9092/admin/register-admin
Content-Type: application/json

{
    "firstname": "Admin",
    "lastname": "User",
    "email": "{{admin_email}}",
    "password": "{{admin_password}}"
}

### 1.3 Forgot Password
POST http://localhost:9092/admin/forgot-password
Content-Type: application/json

{
    "email": "{{admin_email}}"
}

### 1.3.1 Reset Password
POST http://localhost:9092/admin/reset-password
Content-Type: application/json

{
    "password": "{{admin_password}}",
    "resetPasswordToken": "97939e342150650ea0acfba42a92d0a84ddcd8ab"
}

### 1.4 Profile
GET http://localhost:9092/admin/users
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MSwiaWF0IjoxNzg5MzI2NTUxLCJleHAiOjE3OTE5MTg1NTF9.8x2hyihl6E1v6uTFgr7XqXF21tIOuw3EmwZwUAcgRk8

## 2.User
### 2.1 Login
POST http://localhost:9092/api/auth/local
Content-Type: application/json

{
    "identifier": "{{user_email}}",
    "password": "{{user_password}}"
}

### 2.2 Register
POST http://localhost:9092/api/auth/local/register
Content-Type: application/json

{
    "username": "user2",
    "email": "user2@gmail.com",
    "password": "{{user_password}}"
}

### 2.3 Forgot Password
POST http://localhost:9092/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{user_email}}"
}

### 2.4 Profile
GET http://localhost:9092/api/users/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MSwiaWF0IjoxNzg5MzI2OTcwLCJleHAiOjE3OTE5MTg5NzB9.1TC4UCKhY1cBETPmdjjMM1W4ZRLjOFQSuAmyyIsregU